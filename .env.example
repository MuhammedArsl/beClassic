# ─────────────────────────────────────────────────────────────
# Vorlage für Umgebungsvariablen.
# Zum Verwenden: Datei nach `.env.local` kopieren und Werte eintragen.
# `.env.local` wird NICHT ins Git-Repository übernommen.
#
# Nach jeder Änderung den Entwicklungsserver neu starten —
# .env.local wird nur beim Start gelesen.
# ─────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════
# DASHBOARD (/admin)  —  für den Betrieb des Dashboards nötig
# ═════════════════════════════════════════════════════════════

# ── Supabase: Speicher für Anfragen und Nachrichtenverlauf ───
# 1. Auf supabase.com ein Projekt anlegen (Free-Plan genügt).
# 2. Projekt → SQL Editor → Inhalt von supabase/schema.sql ausführen.
# 3. Projekt → Settings → API → beide Werte hier eintragen.
#
# Bleiben die Werte leer, läuft die Website normal weiter — Anfragen
# werden dann nur in der Server-Konsole protokolliert und das Dashboard
# bleibt leer.

NEXT_PUBLIC_SUPABASE_URL=
# Der `service_role`-Schlüssel, NICHT der anon-Key.
# Er umgeht die Zugriffsregeln und darf niemals in den Browser gelangen.
SUPABASE_SERVICE_ROLE_KEY=

# ── Zugang zum Dashboard ─────────────────────────────────────
# Frei wählbares Passwort für die Anmeldung unter /admin/login.
ADMIN_PASSWORD=

# Signaturschlüssel für das Sitzungscookie. Beliebiger Zufallswert,
# mindestens 32 Zeichen. Erzeugen mit:  openssl rand -base64 32
ADMIN_SESSION_SECRET=


# ═════════════════════════════════════════════════════════════
# E-MAIL  —  optional, aber nötig für Antworten an Kunden
# ═════════════════════════════════════════════════════════════

# ── Resend ───────────────────────────────────────────────────
# Schlüssel unter resend.com/api-keys.
#
# Ohne Schlüssel bleibt das Dashboard voll nutzbar: Antworten werden im
# Verlauf gespeichert, aber nicht versendet — dafür steht neben jeder
# Nachricht ein Hinweis und die Kontaktdaten sind verlinkt.
RESEND_API_KEY=

# Absenderadresse. Die Domain muss bei Resend verifiziert sein.
# Zum Ausprobieren ohne eigene Domain: BeClassic <onboarding@resend.dev>
# — damit lässt sich allerdings nur an die eigene, bei Resend
# registrierte Adresse senden.
ANFRAGE_ABSENDER=

# Wohin die Benachrichtigung über neue Anfragen geht.
# Leer lassen = keine Benachrichtigung (Anfragen stehen trotzdem im Dashboard).
ANFRAGE_EMPFAENGER=


# ═════════════════════════════════════════════════════════════
# SPAM-SCHUTZ  —  optional
# ═════════════════════════════════════════════════════════════

# ── Cloudflare Turnstile ─────────────────────────────────────
# Kostenlos unter: dash.cloudflare.com → Turnstile → "Add Site"
# Dort die Domain eintragen; Widget-Modus "Managed" ist die richtige Wahl.
#
# Sind beide Werte leer, entfällt die Sicherheitsprüfung und das Formular
# funktioniert unverändert — geschützt bleibt es durch Honeypot,
# Tempo-Prüfung und Rate-Limit auf dem Server.

# Öffentlicher Schlüssel (steht im Browser-Code, ist nicht geheim)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Geheimer Schlüssel — NIEMALS ins Repository, nur beim Hoster hinterlegen
TURNSTILE_SECRET_KEY=
